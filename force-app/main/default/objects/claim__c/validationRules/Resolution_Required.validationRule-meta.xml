<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Resolution_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c,&apos;Closed&apos;), ISBLANK(Resolution__c))</errorConditionFormula>
    <errorMessage>Resolution is required before closing.</errorMessage>
</ValidationRule>

<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rejection_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c,&apos;Rejected&apos;), ISBLANK(Rejection_Reason__c))</errorConditionFormula>
    <errorMessage>Rejection Reason is required when claim is rejected.</errorMessage>
</ValidationRule>
